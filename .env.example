# Career Guidance Platform - Environment Configuration
# Demo mode: copy this to .env and run: docker-compose up --build

# === Database ===
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=career_app
DATABASE_URL=postgresql://user:password@db:5432/career_app

# === JWT & Authentication ===
JWT_SECRET=dev-change-me-secret-for-production
PASSWORD_SALT=dev-password-salt
ACCESS_TOKEN_EXPIRE_SECONDS=1800
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# === AI Chatbot (Gemini) ===
# Get your free API key from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# === Frontend Internal URLs (Docker network) ===
VITE_AUTH_API_BASE_URL=http://auth-service:8000
VITE_CORE_API_BASE_URL=http://core-service:8000
VITE_GRADE_API_BASE_URL=http://grade-service:8000
VITE_CHATBOT_API_BASE_URL=http://chatbot-service:8000
