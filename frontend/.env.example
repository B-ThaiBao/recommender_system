# Frontend Environment Configuration
# When running with Docker Compose, use service names instead of localhost
# When running dev server, use localhost

# === Local Development Mode (npm run dev) ===
VITE_AUTH_API_BASE_URL=http://localhost:9001
VITE_CORE_API_BASE_URL=http://localhost:9002
VITE_GRADE_API_BASE_URL=http://localhost:9003
VITE_CHATBOT_API_BASE_URL=http://localhost:9014

# === Docker Compose Mode (commented out - docker-compose.yml sets these) ===
# VITE_AUTH_API_BASE_URL=http://auth-service:8000
# VITE_CORE_API_BASE_URL=http://core-service:8000
# VITE_GRADE_API_BASE_URL=http://grade-service:8000
# VITE_CHATBOT_API_BASE_URL=http://chatbot-service:8000
